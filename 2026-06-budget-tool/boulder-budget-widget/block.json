{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "charting-boulder/boulder-budget",
	"version": "1.0.0",
	"title": "Boulder Budget Widget",
	"category": "embed",
	"icon": "chart-bar",
	"description": "The Balance Boulder's Budget interactive, embedded in an isolated, auto-resizing frame.",
	"keywords": [ "boulder", "budget", "interactive", "chart", "newspack" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"anchor": true
	},
	"attributes": {
		"src":      { "type": "string", "default": "" },
		"height":   { "type": "string", "default": "" },
		"maxWidth": { "type": "string", "default": "720px" },
		"title":    { "type": "string", "default": "Balance Boulder's Budget — interactive" },
		"caption":  { "type": "string", "default": "" }
	},
	"textdomain": "boulder-budget-widget"
}
